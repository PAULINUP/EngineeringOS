# Ambientes locais — a imagem instala as dependências a partir do requirements
__pycache__/
*.pyc
*.pyo
venv/
.venv/
node_modules/
dashboard/node_modules/
dashboard/.vite/
# dashboard/dist NÃO é ignorado aqui: se existir localmente serve de cache,
# e o estágio de build da imagem o regenera de qualquer forma
alembic/versions/__pycache__/

# Bancos e backups locais: em produção o banco é o PostgreSQL gerenciado.
# Enviar o .db local sobrescreveria dados e levaria conteúdo de desenvolvimento.
*.db
# data_export.json.gz VAI para a imagem: e como o acervo chega ao banco de
# produção (sem proxy TCP, a importação roda de dentro do contêiner)
*.db-journal
*.db.bak-*
*.db.antes-de-restaurar-*
backups/
memory_dumps/

# Segredos e logs
.env
*.log

# Desenvolvimento
.git/
.gitignore
.pytest_cache/
# tests/ (mantidos: leves e úteis para diagnosticar em produção)
*.bat
agents/impontuality/memory/
