@version 1.0.0
@domain "calculus"

# Cálculo para Engenharia I — A base matemática fundamental para a modelagem de sistemas dinâmicos na Engenharia.

KNOWLEDGE calculus.AlgebraElementar {
  title: "Álgebra Elementar"
  domain: "calculus"
  definition: "Operações fundamentais, frações, potenciação e radiciação."
  requires: []
}

KNOWLEDGE calculus.Funcoes {
  title: "Funções"
  domain: "calculus"
  definition: "Definição de funções matemáticas, domínio, imagem e gráficos."
  requires: [calculus.AlgebraElementar]
}

KNOWLEDGE calculus.Limites {
  title: "Limites"
  domain: "calculus"
  definition: "Conceito de limite, propriedades, limites laterais e no infinito."
  requires: [calculus.Funcoes]
}

KNOWLEDGE calculus.Continuidade {
  title: "Continuidade"
  domain: "calculus"
  definition: "Definição de continuidade e Teorema do Valor Intermediário."
  requires: [calculus.Limites]
}

KNOWLEDGE calculus.Derivadas {
  title: "Derivadas"
  domain: "calculus"
  definition: "Taxa de variação, regras de derivação (produto, quociente, cadeia)."
  requires: [calculus.Limites, calculus.Continuidade]
}

KNOWLEDGE calculus.AplicacoesdeDerivadas {
  title: "Aplicações de Derivadas"
  domain: "calculus"
  definition: "Otimização, máximos e mínimos, concavidade e Teorema de L'Hôpital."
  requires: [calculus.Derivadas]
}

KNOWLEDGE calculus.IntegraisIndefinidas {
  title: "Integrais Indefinidas"
  domain: "calculus"
  definition: "Antiderivadas e propriedades básicas de integração."
  requires: [calculus.Derivadas]
}

