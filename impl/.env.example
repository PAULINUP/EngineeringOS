# Copie para .env e preencha. O .env NÃO vai para o Git.
# Gere o segredo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production
EOS_ENV=development

# Obrigatório quando EOS_ENV=production (mínimo 32 caracteres).
# Em desenvolvimento, se ausente, a aplicação usa um segredo efêmero por
# processo — reiniciar invalida os tokens, que é o comportamento seguro.
JWT_SECRET_KEY=

# Banco. SQLite serve para desenvolvimento local; em qualquer lugar com
# sistema de arquivos efêmero (Railway, Fly, Heroku) use PostgreSQL, senão
# o acervo inteiro some no primeiro reinício.
DATABASE_URL=sqlite+aiosqlite:///./engineeringos.db
# DATABASE_URL=postgresql+asyncpg://eos_user:SENHA@localhost:5432/engineeringos

# Compose local
POSTGRES_USER=eos_user
POSTGRES_PASSWORD=
POSTGRES_DB=engineeringos

# Origens autorizadas do frontend, separadas por vírgula.
# Em produção, coloque o domínio real — "*" com credenciais é proibido.
EOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sessão e proteções
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12
EOS_RATE_LIMIT=1

# Observabilidade (opcional). Sem DSN, a aplicação sobe normalmente.
SENTRY_DSN=

# Fila
REDIS_URL=redis://localhost:6379/0
